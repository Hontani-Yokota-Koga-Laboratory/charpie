# dependencies / build output
node_modules/
dist/
dist-server/
*.tsbuildinfo
.vite/

# logs, OS & editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea
.vscode
*.swp

# local / machine-specific (shell & tool config mounted into the workspace)
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.claude/

# temporary files written by the charpie server (atomic save)
.*.charpie.*.tmp

# 各自の図（共有するのは見本の mae_example / mae_talk / charpie_guide だけ）
diagrams/*
!diagrams/mae_example.charpie
!diagrams/mae_talk.charpie
!diagrams/charpie_guide.charpie
# charpie_guide が参照する画像
!diagrams/assets/
diagrams/assets/*
!diagrams/assets/guide/
# deleted .charpie files (restorable from the UI)
.trash/
