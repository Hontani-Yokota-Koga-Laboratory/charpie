# スライドのデモ（page / layout / slot）
set canvas=1280x720 gap=12 fontmin=12 fontmax=28

style title  { font: 36; weight: bold; halign: left; text: #0f172a; stroke: none; fill: none; }
style muted  { font: 14; text: #64748b; stroke: none; fill: none; }
style band   { fill: #4f46e5; stroke: none; }
style accent { fill: #eef2ff; stroke: #6366f1; text: #312e81; }
style body   { font: 22; halign: left; valign: top; stroke: none; fill: none; }

# 全ページ共通：上の帯、フッター、ページ番号、タイトル枠
layout default {
  rect  band   at (0, 0) size 1280x12 .band
  text  footer "Charpie slides beta"  at (40, 676) size 600x36 .muted halign=left
  text  pageno "{page} / {pages}"     at (1100, 676) size 140x36 .muted halign=right
  slot  title  "タイトル"              at (40, 36) size 1200x72 .title
}

# 本文が箇条書き 1 枚
layout bullets extends default {
  slot  body list at (40, 136) size 1200x520
}

# 左右 2 段
layout two extends default {
  slot  left   "左の本文"  at (40, 136) size 580x520 .body
  slot  right  "右の本文"  at (660, 136) size 580x520 .body
}

# 表紙はタイトルを中央に大きく、帯とフッターは消す
page cover "表紙" {
  title "テキストが正本のスライド" at (40, 260) size 1200x90 font=48 halign=center
  text  sub "Charpie slides beta — page / layout / slot" at (240, 370) size 800x48 .muted font=20
  hide  band footer pageno
}

page idea "考え方" {
  title "共通部はレイアウトに 1 回だけ書く"
  round lay  "layout\n（帯・フッター・番号・枠）" at (80, 200) size 300x120 .accent
  round page "page\n（中身だけ）"                at (520, 200) size 240x120 .accent
  rect  out  "スライド"                          at (900, 200) size 240x120
  lay -> page "slot を埋める"
  page -> out "check / export"
}

page compare "比較" layout=two {
  title "2 段レイアウト"
  left  "左の枠には文章を書ける。\n改行は \\n で入れる。"
  right "右の枠も同じ。\n数式もそのまま: $E = mc^2$"
}

page points "箇条書き" layout=bullets {
  title "箇条書きは list ブロックで書く"
  body {
    - 1 行 1 項目、先頭は - か 1.
      - 2 文字下げると入れ子
      - **項目全体を二重アスタリスクで囲むと太字**
    - 数式もそのまま: $\nabla f(\theta) = 0$
    - 収まる最大の文字サイズに自動で揃う
  }
}

page result "結果" {
  title "表は Markdown の書き方で"
  table res at (140, 150) size 1000x300 align=l,r,r {
    | 手法          | 精度 (%) | パラメータ数 |
    |--------------|--------:|-----------:|
    | ViT-S        | 79.8    | 22M        |
    | DeiT-S       | 79.9    | 22M        |
    | **提案手法** | **82.1** | **22M**    |
  }
  text note "罫線は booktabs 風（rules=grid で格子）" at (140, 480) size 1000x40 .muted font=18
}

page embed "既存の図" {
  title "既存の図は image の src に .charpie を指定"
  image fig "全体図" at (40, 130) size 1200x520 src="mae_example.charpie"
}
